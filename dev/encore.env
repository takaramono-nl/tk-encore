# Dev environment for the Docker Compose stack. Source from the repo root:
#   . ./dev/encore.env
#
# These credentials are local-only. Never reuse them outside `make dev-*`.

export ENCORE_LISTMONK_URL="http://127.0.0.1:${LISTMONK_PORT:-9001}"
export ENCORE_LISTMONK_USER="encore"
export ENCORE_LISTMONK_TOKEN="encore-dev-token"
export ENCORE_DB="$PWD/.dev/encore.db"
export ENCORE_CONFIG="$PWD/.dev/encore.toml"
